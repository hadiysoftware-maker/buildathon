{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "crons": [{ "path": "/api/cron/daily", "schedule": "30 2 * * *" }],
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "functions": {
    "src/app/api/ai/chat/route.ts": { "maxDuration": 60, "memory": 1024 },
    "src/app/api/files/**/route.ts": { "maxDuration": 30 }
  }
}
